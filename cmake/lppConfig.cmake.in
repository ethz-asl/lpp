@PACKAGE_INIT@

# Resolve our prefix before dependencies can change PACKAGE_PREFIX_DIR on
# CMake versions older than 3.30.
set_and_check(lpp_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include/lpp")

include(CMakeFindDependencyMacro)
if (@glog_FOUND@)
    set(_lpp_saved_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(glog MODULE)
    set(CMAKE_MODULE_PATH "${_lpp_saved_module_path}")
    unset(_lpp_saved_module_path)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/lppTargets.cmake")
